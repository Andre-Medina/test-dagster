{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dagster UI",
      "type": "debugpy",
      "request": "launch",
      "module": "dagster",
      "args": ["dev", "-m", "test_dagster.definitions", "--port", "4000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.pixi/envs/default/bin/python",
      "env": {
        "DAGSTER_HOME": "${workspaceFolder}/.dagster_home",
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Materialize all partitions (debug checks)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_partitions.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.pixi/envs/default/bin/python",
      "env": {
        "DAGSTER_HOME": "${workspaceFolder}/.dagster_home",
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
